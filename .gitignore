# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---
node_modules
/.pnpm-store

# --- Build output ---
/.next/
/out/
next-env.d.ts
*.tsbuildinfo
packages/*/dist/

# --- Testing ---
coverage/

# --- Debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Env files & secrets ---
.env*
!.env.example
*.pem
# Narrow, generated WayFlow container env (host secrets the wayflow service
# needs: CINATRA_BRIDGE_TOKEN / OPENAI_API_KEY / WAYFLOW_BASE_URL). Synced from
# .env.local by scripts/gen-wayflow-env.mjs on every `npm run services`. The
# `.env*` glob above does NOT match this name, so it is listed explicitly.
docker/wayflow/.wayflow.env

# Same pattern for the Nango container (NANGO_ENCRYPTION_KEY only) — synced
# from .env.local by scripts/gen-nango-env.mjs on every `npm run services`.
docker/nango/.nango.env

# The Graphiti knowledge-graph indexer has NO env file (cinatra#2582): its
# provider key reaches the container through the environment of the `docker
# compose` command that creates it, and scripts/gen-graphiti-env.mjs writes
# nothing. This entry is kept as a BACKSTOP, not as a description of something
# that exists: it names an artifact that must never be committed, and the
# generator deletes any leftover of it on every run. Removing the entry would
# make a re-introduced plaintext file committable.
docker/graphiti/.graphiti.env*

# Same pattern for the Plane MCP bridge (cinatra#1238): the minted dev/demo Plane
# PAT + workspace slug the bridge holds, written by scripts/fixtures/provision-plane.mjs.
# The `.env*` glob above does NOT match this basename, so it is listed explicitly.
docker/plane-mcp/.plane-mcp.env

# --- OS / misc ---
.DS_Store

# --- Claude Code (local-only: memory + ephemeral session data) ---
# Root-anchored: an unanchored `memory/` would also swallow the tracked
# workspace package at packages/memory.
/memory/
.claude/

# --- Python (docker/wayflow) ---
__pycache__/
*.py[cod]

# --- Local runtime data (generated, never committed) ---
/data/
/generated/
cinatra-agents.lock
.cinatra-setup-branch-failed
# generated by `pnpm build:auth-migrate-bundle` / `pnpm build:schema-bootstrap-bundle`,
# emitted into the Docker image at build time
scripts/better-auth-migrate.bundle.mjs
scripts/schema-bootstrap.bundle.mjs
# generated by `pnpm build:exec-service-bundle` (exec-plane broker/worker service
# entrypoints), emitted into the Docker image at build time
scripts/exec-broker-service.bundle.mjs
scripts/exec-worker-service.bundle.mjs
# generated at runtime by `drush config:export`
docker/drupal/config/sync/

# --- Agent publish markers (runtime metadata in the agents/ tree) ---
agents/**/.cinatra-published.json

# --- Dev-app clones (synced by `cinatra setup`; source of truth = companion repos) ---
/dev/

# --- Extensions (root-level clone target for @cinatra-ai/* + vendored bundles; nothing here is tracked) ---
/extensions/

# --- Playwright / e2e artifacts ---
playwright-report/
playwright-report-design/
test-results/
# The design suite selection plan the CI select job writes and publishes
# (scripts/ci/design-select.mjs --out). A committed copy would be a stale
# decision sitting next to the live one.
/design-select.json
.playwright-mcp/
# per-suite auth state + seed artifacts; keep each .auth/.gitignore anchor tracked.
tests/e2e/**/.auth/*
!tests/e2e/**/.auth/.gitignore
# WP/Drupal UAT seed IDs (regenerated each run)
tests/e2e/wp-drupal-uat/.uat/

# --- Proof artifacts (captures, run records, PR proof bundles) ---
# Never committed: they are posted on the PR and cited by permalink.
evidence/
pr-evidence/

# Internal planning notes (local only)
.planning/

# --- cinatra-ai org baseline (union-merged from cinatra-ai/ci config/baseline.gitignore) ---

# Dependencies (node / pnpm)
.pnpm-store/

# Build output (monorepo-typical)
dist/
# re-include the deliberately tracked vendored builds
!packages/mcp-server/vendor/*/dist/
!packages/mcp-server/vendor/*/dist/**
build/
out/
.next/
.turbo/

# Logs and caches
*.log
pnpm-debug.log*
.cache/
.eslintcache

# OS cruft
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Env files and secrets
*.key
.codex-verdicts/

# proof artifacts never live in the checkout (evidence/ and pr-evidence/ are
# ignored by the branch that removes the tracked evidence/ tree)
verification/
docs/internals/proofs/

# --- development artifacts never live in the checkout (tree-hygiene gate rules) ---
# Enforced for the org by scripts/ci/product-tree-hygiene.mjs (gates.yml).
evidence/2824-s9k/.run/
.pytest_cache/
/verification/
proofs/
proof/

# Instance-local runtime state written at boot, never tracked. Both 0600
# per-boot local credentials live here: the development admin bypass token
# and the local-caller gate credential.
/.cinatra/
