      ]
    },
    "installed-extensions-filter": {
      "manifest": "app-extensions",
      "selector": "combobox [aria-label=\"Filter installed extensions by state\"] (URL-driven ?tab= server filter: all|active|locked|archived, cinatra#1571)",
