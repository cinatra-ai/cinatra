      "drafts-draft": {
        "component_type": "ApiNode",
        "id": "drafts-draft",
        "name": "Draft emails",
        "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
        "http_method": "POST",
        "data": {
          "system": "You are an email drafting agent.\n\nStep 1: Call objects_get with confirmedRecipientsRef to fetch the recipients list.\n\nStep 1b: For each entry of contextSlotBindings, call artifact_representation_get({ artifactId, representationRevisionId }) to read the pinned context the operator selected. Read the context ONLY through that road \u2014 never reach for the parent run's slot or project. Skip an entry the road refuses.\n\nStep 2: Generate exactly one personalized initial outreach email per recipient using offeringCompanyWebsite, callToAction, and senderName as context.\n\nStep 3 \u2014 CRITICAL: Call objects_save BEFORE returning any JSON. Use exactly this structure:\n  objects_save({\n    typeHint: \"@cinatra-ai/campaigns:email-draft-bundle\",\n    rawData: {\n      cinatra_agent_run_id: \"<agent_run_id input>\",\n      drafts: [\n        { recipientId: \"<contactId>\", recipientName: \"...\", recipientEmail: \"...\", recipientCompany: \"...\", subject: \"...\", body: \"...\", status: \"draft\" }\n      ]\n    }\n  })\nEach draft names its recipient: recipientId is the confirmed recipient's contactId, and recipientName is its name. recipientCompany is the confirmed recipient's company name, or \"\" when the list names none. A recipient without an email address still gets its draft: write recipientEmail: \"\" and keep its recipientId and recipientName.\n\nStep 4: Return ONLY this JSON using the object ID returned by objects_save: {\"draftBundleRef\":\"<objectId returned by objects_save>\",\"summary\":\"<one sentence summary>\"}. Each draft has a non-empty subject, and no two drafts have the same body: each body is filed as its own email body for the review.\n\nDo NOT return draftBundleRef without completing Step 3. Never skip objects_save. Do not send emails \u2014 this agent only drafts.",
          "user": "Execute the email drafting task now and return the result as JSON.\nInputs:\n- offeringCompanyWebsite: {{ offeringCompanyWebsite }}\n- callToAction: {{ callToAction }}\n- senderName: {{ senderName }}\n- confirmedRecipientsRef: {{ confirmedRecipientsRef }}\n- contextSlotBindings: {{ contextSlotBindings }}",
          "agent_id": "email-drafting",
          "agent_run_id": "{{ agent_run_id }}"
        },
        "outputs": [
          {
            "title": "draftBundleRef",
            "type": "string",
            "json_schema": {
              "format": "uuid"
            }
          }
        ],
        "metadata": {
          "cinatra": {
            "riskClass": "draft_create",
            "requiresApproval": true,
            "publishes": false
          }
        },
        "inputs": [
          {
            "title": "agent_run_id",
            "type": "string",
            "default": ""
          },
          {
            "title": "offeringCompanyWebsite",
            "type": "string",
            "default": ""
          },
          {
            "title": "callToAction",
            "type": "string",
            "default": ""
          },
          {
            "title": "senderName",
            "type": "string",
            "default": ""
          },
          {
            "title": "confirmedRecipientsRef",
            "type": "string",
            "default": ""
          },
          {
            "title": "contextSlotBindings",
            "type": "array",
            "default": [],
            "json_schema": {
              "items": {
                "type": "object"
              }
            }
          }
        ]
      },
      "drafts-read_drafts": {
        "component_type": "ApiNode",
        "id": "drafts-read_drafts",
        "name": "Read the saved drafts for the review",
        "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
        "http_method": "POST",
        "data": {
          "tool": "extension_tool",
          "input": {
            "name": "saved_drafts",
            "input": {
              "draftBundleRef": "{{ draftBundleRef }}",
              "confirmedRecipientsRef": "{{ confirmedRecipientsRef }}"
            }
          },
          "agent_run_id": "{{ agent_run_id }}"
        },
        "inputs": [
          {
            "title": "agent_run_id",
            "type": "string",
            "default": ""
          },
          {
            "title": "draftBundleRef",
            "type": "string",
            "default": ""
          },
          {
            "title": "confirmedRecipientsRef",
            "type": "string",
            "default": ""
          }
        ],
        "outputs": [
          {
            "title": "draftBundle",
            "type": "object",
            "default": {}
          },
          {
            "title": "ok",
            "type": "boolean",
            "default": false
          },
          {
            "title": "recipients",
            "type": "array",
            "default": [],
            "json_schema": {
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "metadata": {
          "cinatra": {
            "riskClass": "read_only",
            "requiresApproval": false,
            "description": "The agent reads the drafts this run saved, so the bodies filed for the review and handed on are the drafts the send acts on. It binds each draft to exactly one recipient of the run's approved recipient list and hands on each draft's recipient (name, email, company) as the approved list names it, in draft order. Each draft also carries the approved contact as its contactId, which the filing stores on its body. A saved bundle that is missing or holds no drafts, a draft for a contact that is not approved or with an address or name that is not the approved one, two drafts for one recipient, and an approved recipient without a draft end the run with the reason before anything is filed."
          }
        }
      },
      "drafts-end": {
        "component_type": "EndNode",
        "id": "drafts-end",
        "name": "End",
        "outputs": [
          {
            "title": "userResponse",
            "type": "string",
            "default": ""
          },
          {
            "title": "draftBundleRef",
            "type": "string",
            "json_schema": {
              "format": "uuid"
            },
            "default": ""
          },
          {
            "title": "recipients",
            "type": "array",
            "default": [],
            "json_schema": {
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "title": "approvedBodyArtifacts",
            "type": "array",
            "default": [],
            "json_schema": {
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string"
                  },
                  "representationRevisionId": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "title": "callToAction",
            "type": "string",
            "default": ""
          }
        ]
      },
      "drafts-file_drafts": {
        "component_type": "ApiNode",
        "id": "drafts-file_drafts",
        "name": "File each drafted body for the review",
        "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
        "http_method": "POST",
        "data": {
          "tool": "artifact_materialize",
          "input": {
            "extension": "@cinatra-ai/email-artifacts",
            "objectTypeId": "@cinatra-ai/email:body",
            "declaredMime": "text/markdown",
            "content": "{# pyagentspec-input-hint (do not remove): {{ draftBundle }} #}{{ draftBundle.draftedEmails | tojson }}",
            "memberContentField": "body",
            "memberTitleField": "subject",
            "memberDataFields": [
              "contactId"
            ],
            "memberData": {
              "campaignId": "{{ campaignId }}"
            },
            "memberRunIdField": "runId",
            "node_id": "drafts-file_drafts"
          },
          "agent_run_id": "{{ agent_run_id }}"
        },
        "inputs": [
          {
            "title": "draftBundle",
            "type": "object",
            "default": {}
          },
          {
            "title": "campaignId",
            "type": "string",
            "json_schema": {
              "format": "uuid"
            },
            "default": ""
          },
          {
            "title": "agent_run_id",
            "type": "string",
            "default": ""
          }
        ],
        "outputs": [
          {
            "title": "artifacts",
            "type": "array",
            "default": [],
            "json_schema": {
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string"
                  },
                  "representationRevisionId": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "title": "reviewTargets",
            "type": "string",
            "default": "[]"
          }
        ],
        "metadata": {
          "cinatra": {
            "riskClass": "write",
            "requiresApproval": false,
            "publishes": false,
            "description": "The host files each saved draft's body as its own email body, in draft order, titled by its subject: the filed bytes are the saved body, so the send reuses each one. Each body is filed with its contact (the read step writes it from the approved recipient list), the campaign of this run and the id of this run. The reference pairs it answers are the review's target set and the bodies this flow hands on."
          }
        }
      },
      "drafts-approval_gate": {
        "component_type": "InputMessageNode",
        "id": "drafts-approval_gate",
        "name": "Review drafts",
        "metadata": {
          "cinatra": {
            "riskClass": "read_only",
            "requiresApproval": true,
            "surfaceGateInputs": true,
            "a2uiSurfaceId": "email-drafting:review:input",
            "autoSkipWhenInputsPresent": false,
            "inputMessageSchema": {
              "type": "object",
              "properties": {
                "userResponse": {
                  "type": "string",
                  "title": "Drafts review note"
                }
              },
              "required": [
                "userResponse"
              ]
            },
            "description": "The review of the drafted bodies. The marker below names the input that carries the bodies this run filed, so the host pins exactly those revisions and opens one review per body, in draft order, while the run waits here. The decision is the host's review: this flow owns the pause and draws no screen of its own.",
            "artifactReview": {
              "targetsInput": "reviewTargets"
            }
          }
        },
        "outputs": [
          {
            "title": "userResponse",
            "type": "string"
          }
        ],
        "inputs": [
          {
            "title": "reviewTargets",
            "type": "string",
            "default": "[]"
          }
        ]
      },
      "drafts-uuid_match": {
        "component_type": "PluginRegexNode",
        "id": "drafts-uuid_match",
        "name": "drafts-uuid_match",
        "metadata": {
          "cinatra": {
            "publishes": false
          }
        },
        "inputs": [
          {
            "title": "text",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "title": "output",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "branches": [
          "next"
        ],
        "input_mapping": {},
        "output_mapping": {},
        "regex_pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "return_first_match_only": false,
        "component_plugin_name": "NodesPlugin",
        "component_plugin_version": "26.1.0"
      },
      "drafts-check_inputs_predicate": {
        "component_type": "PluginTemplateNode",
        "id": "drafts-check_inputs_predicate",
        "name": "drafts-check_inputs_predicate",
        "metadata": {
          "cinatra": {
            "publishes": false
          }
        },
        "inputs": [
          {
            "title": "matches"
          },
          {
            "title": "campaignId",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "title": "output",
            "type": "string"
          }
        ],
        "branches": [
          "next"
        ],
        "input_mapping": {},
        "output_mapping": {},
        "template": "{% set c = (campaignId or '')|string|trim(' \\t\\r\\n') %}{% if not (matches and (matches|length > 0)) %}missing{% elif c|length == 36 and c[8] == '-' and c[13] == '-' and c[18] == '-' and c[23] == '-' and c.split('-')|length == 5 and (c|list|reject('in', '0123456789abcdefABCDEF-')|list|length) == 0 %}present{% else %}no_campaign{% endif %}",
        "component_plugin_name": "NodesPlugin",
        "component_plugin_version": "26.1.0"
      },
      "drafts-check_inputs": {
        "component_type": "BranchingNode",
        "id": "drafts-check_inputs",
        "name": "drafts-check_inputs",
        "metadata": {
          "cinatra": {
            "purpose": "skip-data_gate-when-confirmedRecipientsRef-is-valid-uuid"
          }
        },
        "inputs": [
          {
            "title": "verdict",
            "type": "string"
          }
        ],
        "outputs": [],
        "branches": [
          "default",
          "skip",
          "no_campaign"
        ],
        "mapping": {
          "present": "skip",
          "no_campaign": "no_campaign"
        }
      },
      "drafts-inputs_missing": {
        "component_type": "OutputMessageNode",
        "id": "drafts-inputs_missing",
        "name": "No recipients to draft for",
        "inputs": [],
        "message": "This run stopped before drafting: no approved recipient list reached the drafting step, so there was nobody to write to. Start the campaign again and approve a recipient list first.",
        "metadata": {
          "cinatra": {
            "purpose": "plain-language-ending-for-the-retired-data-gate"
          }
        }
      },
      "drafts-campaign_missing": {
        "component_type": "OutputMessageNode",
        "id": "drafts-campaign_missing",
        "name": "No campaign to draft for",
        "inputs": [],
        "message": "This run stopped before drafting: it has no usable campaign (none was given, or the value is not a campaign id), and every email body is filed and reviewed for one campaign, so nothing was drafted. Start the drafting from its campaign.",
        "metadata": {
          "cinatra": {
            "purpose": "plain-language-ending-for-a-run-without-a-campaign"
          }
        }
      }
    }
  }
}
